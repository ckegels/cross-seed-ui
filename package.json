{
  "name": "cross-seed-ui",
  "version": "0.3.0",
  "private": true,
  "description": "Web UI to manage, monitor and get statistics for cross-seed v6 daemons (hub + agents)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/agent",
    "packages/hub",
    "packages/web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -p packages/shared && tsc -p packages/agent && tsc -p packages/hub && tsc -p packages/web",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-reporter=spec \"packages/*/test/**/*.test.ts\"",
    "dev:agent": "node --import tsx --watch packages/agent/src/main.ts --config dev/agent.json",
    "dev:hub": "node --import tsx --watch packages/hub/src/main.ts --config dev/hub.json",
    "dev:web": "npm -w packages/web run dev",
    "build": "node scripts/build.mjs",
    "release": "node scripts/build.mjs --release"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
