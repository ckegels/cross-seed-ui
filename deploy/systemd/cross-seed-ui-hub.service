[Unit]
Description=cross-seed-ui hub (web UI)
Documentation=https://github.com/ckegels/cross-seed-ui
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=csui
Group=csui
Environment=NODE_ENV=production
ExecStart=@NODE@ --disable-warning=ExperimentalWarning @PREFIX@/current/hub.mjs --config @ETC@/hub.json
Restart=on-failure
RestartSec=5
# the hub needs nothing but its state dir and the network
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@STATE@/hub
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
